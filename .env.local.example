# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Server only. Never prefix with NEXT_PUBLIC_. Bypasses row-level security,
# so it is used by scripts/create-users.mjs and nothing else.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Server only. The six AI routes read this. If it is absent every AI feature
# returns its documented fallback message and the workflow continues manually.
ANTHROPIC_API_KEY=<anthropic api key>
