node_modules/
.next/
out/
build/
dist/
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage/

# ---------------------------------------------------------------------
# Secrets. Nothing here is ever committed.
#
# The *.example files ARE committed and must stay that way: they are how
# somebody knows which variables to set. The negations below are what
# keeps them, so do not reorder them above the .env.* line.
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.p12

# Written by deploy/aws/01-database.sh. Holds the database password.
deploy/aws/.state

# ---------------------------------------------------------------------
# Platform and tooling
# ---------------------------------------------------------------------
.vercel
.aws-sam/
.serverless/

# ---------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

# Browser automation. The screenshot harness writes to /tmp, but the MCP
# server drops captures into the working directory. Scoped to the root so
# a real image asset further down is not silently skipped.
.playwright-mcp/
/*.png

# project/ and deploy/ were once ignored wholesale while every file in
# them was tracked, so the rules did nothing except quietly drop any NEW
# file added to them. Ignore what should not be committed, by name.

# The working handoff. It names what is still missing against the marking
# scheme, and the repository link is in the examiner's Links.txt, so it
# stays on disk rather than in the submission. Remove this line to ship it.
HANDOFF.md
