# Local development. Copy to .env — .env is gitignored.
DATABASE_URL=postgresql://medicare:medicare@localhost:5433/medicare

# Sign your session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me

# Optional. Without it every AI feature returns its documented fallback
# and the clinical workflow continues manually.
ANTHROPIC_API_KEY=

CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
