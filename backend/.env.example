# Local development. Copy to .env — .env is gitignored.
DATABASE_URL=postgresql://medicare:medicare@localhost:5433/medicare

# Sign your session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me

# AI provider: bedrock | anthropic | none
# "none" is fully supported — every AI feature shows its fallback message.
# "bedrock" needs model access granted in the Bedrock console first.
AI_PROVIDER=bedrock
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-6-v1
ANTHROPIC_API_KEY=

CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
