# The FastAPI service. Locally that is the API container from
# docker-compose; in production it is the App Runner URL.
#
# This is the only variable the frontend needs, and note the absence of a
# NEXT_PUBLIC_ prefix: every call the browser makes is relative to this
# application, so the API's address is never embedded in the bundle. There
# is no database credential and no AI key here either — the browser talks
# to this application, this application talks to the API, and the API is
# the only thing holding a secret.
API_URL=http://localhost:8000
